// Markdown 浏览器（webview 版）：左边编辑、右边渲染，支持粘贴 / 编辑 / 渲染 / 显示
// 标签页：可同时打开多个文件；当前标签页有内容时，打开文件会新建标签页载入；关闭最后一个标签页则清空。
// 未保存保护：有改动的标签页在标签名与窗口标题显示 ●；关闭脏标签弹出「保存 / 不保存 / 取消」，
//   文件→退出时按顺序逐个询问未保存标签；取消（含另存为对话框被取消）会中止关闭/退出。
//   标题栏 ✕ 同样走该流程（运行时拦截 delete-event 后回调 __onNativeClose），取消则窗口保持打开。
// 编辑快捷键：Ctrl+Z 撤销 / Ctrl+Y、Ctrl+Shift+Z 重做（自建撤销栈，600ms 内连续输入合并一步）/
//   Ctrl+F 查找（Enter 下一个、Shift+Enter 上一个、Esc 关闭）/ Ctrl+Tab、Ctrl+Shift+Tab 切换标签 /
//   Tab 缩进两格、Shift+Tab 反缩进；Ctrl+C/X/V/A 等系统原生键直接可用。
//   查找匹配用浮层高亮（WebKitGTK 下编辑器失焦不画选区）：镜像元素测量定位，随滚动跟随、随缩放宽重新测量。
// 菜单栏：文件 → 新建标签页 / 打开…(.md) / 保存 / 另存为… / 查找 / 关闭标签页 / 退出（退出整个编辑器）；快捷键 Ctrl+T/O/S/Shift+S/F/W。
// 中间分隔条可左右拖动调整编辑区/预览区比例（双击复位 50:50）。
//   Linux 走原生 GTK 对话框（webview 桥 __cOpenFile/__cSaveFile/__cExit），
//   其他平台自动回退 <input type="file"> / 浏览器下载。
// 用法：
//   codong run test/markdown_browser-comlex.cod                  # 打开内置示例文档
//   codong run test/markdown_browser-comlex.cod -- notes.md      # 打开指定 .md 文件（关联打开）
// 文件关联：用 test/mdview.sh + test/mdview.desktop，然后执行
//   xdg-mime default mdview.desktop text/markdown
// 注意：三引号字符串内所有 { } 必须写成 \{ \}（否则按插值解析）。

path = ""
all_args = args.all()
if all_args.len() > 0 {
    path = all_args[0]
}

content = """# 欢迎使用 Markdown 浏览器

左边 **编辑**，右边 **渲染**，实时预览。

## 功能

- 粘贴：点顶栏「粘贴」按钮，或在编辑区直接 Ctrl+V
- 编辑：Tab 缩进两格，Shift+Tab 反缩进
- 渲染：标题 / 列表 / 引用 / 表格 / 代码块 / 链接 / 图片
- 关联打开：`codong run test/markdown_browser.cod -- file.md`

> 试试在左侧修改文字，右侧预览会实时更新。

| 语法 | 示例 |
| --- | --- |
| 粗体 | **加粗** |
| 行内代码 | `code` |

```go
func main() \{
    fmt.Println("Hello, Codong!")
\}
```
"""

title = "Markdown 浏览器"
file_name = "(未命名)"

if path != "" && fs.exists(path) {
    content = fs.read(path)
    file_name = fs.basename(path)
    title = file_name + " - Markdown 浏览器"
} else if path != "" {
    // 文件不存在：以该文件名新建空标签页（保存时写入该路径）
    content = ""
    file_name = fs.basename(path)
    title = file_name + " - Markdown 浏览器"
}

content_json = json.stringify(content).replace("</script", "<\\/script")
file_json = json.stringify(file_name)
title_json = json.stringify(title)
path_json = json.stringify(path)

html = """<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
body \{ font-family: sans-serif; margin: 0; height: 100vh; display: flex; flex-direction: column; background: #1e1e1e; color: #ddd; \}
#menubar \{ display: flex; background: #2d2d30; border-bottom: 1px solid #333; flex: none; user-select: none; \}
.menu-wrap \{ position: relative; \}
.menu-item \{ display: inline-block; padding: 5px 14px; font-size: 13px; color: #ccc; cursor: pointer; \}
.menu-item:hover, .menu-item.open \{ background: #3b82f6; color: white; \}
#filemenu \{ display: none; position: absolute; top: 100%; left: 0; background: #2d2d30; border: 1px solid #444; min-width: 190px; z-index: 10; box-shadow: 0 6px 16px rgba(0,0,0,.5); \}
#filemenu.show \{ display: block; \}
.mi \{ padding: 6px 18px; font-size: 13px; color: #ddd; cursor: pointer; white-space: nowrap; \}
.mi:hover \{ background: #3b82f6; color: white; \}
.mi .key \{ float: right; margin-left: 28px; color: #9ca3af; font-size: 12px; \}
.mi:hover .key \{ color: #dbeafe; \}
.msep \{ border-top: 1px solid #444; margin: 4px 0; \}
#top \{ display: flex; align-items: center; gap: 8px; padding: 8px 12px; border-bottom: 1px solid #333; flex: none; \}
#tabbar \{ display: flex; background: #252526; border-bottom: 1px solid #333; flex: none; overflow-x: auto; min-height: 34px; \}
.tab \{ display: flex; align-items: center; gap: 7px; padding: 7px 8px 7px 14px; font-size: 13px; color: #9ca3af; cursor: pointer; border-right: 1px solid #333; white-space: nowrap; user-select: none; \}
.tab:hover \{ color: #d1d5db; \}
.tab.active \{ background: #1e1e1e; color: #f0f0f0; box-shadow: inset 0 2px 0 #3b82f6; \}
.tab .x \{ padding: 0 4px; border-radius: 3px; font-size: 12px; line-height: 1; \}
.tab .x:hover \{ background: #4b5563; color: white; \}
button \{ background: #3b82f6; color: white; border: none; border-radius: 5px; padding: 5px 14px; font-size: 13px; cursor: pointer; flex: none; \}
button:hover \{ background: #2563eb; \}
#clear \{ background: #4b5563; \}
#status \{ margin-left: auto; font-size: 12px; color: #9ca3af; white-space: nowrap; \}
#main \{ flex: 1; display: flex; min-height: 0; \}
#editorwrap \{ width: 50%; flex: none; position: relative; display: flex; min-width: 0; overflow: hidden; \}
#editor \{ flex: 1; min-width: 0; box-sizing: border-box; background: #252526; color: #e8e8e8; border: none; padding: 14px; font-family: monospace; font-size: 14px; line-height: 1.6; resize: none; outline: none; \}
#findhl \{ display: none; position: absolute; background: rgba(59,130,246,.45); border-radius: 2px; pointer-events: none; z-index: 3; \}
#splitter \{ flex: none; width: 6px; background: #333; cursor: col-resize; \}
#splitter:hover, #splitter.active \{ background: #3b82f6; \}
#preview \{ flex: 1; min-width: 0; box-sizing: border-box; overflow-y: auto; padding: 14px 22px; background: #1e1e1e; \}
#preview h1, #preview h2 \{ border-bottom: 1px solid #333; padding-bottom: 6px; \}
#preview h1 \{ font-size: 26px; color: #f0f0f0; \}
#preview h2 \{ font-size: 21px; color: #e5e5e5; \}
#preview h3 \{ font-size: 17px; \}
#preview a \{ color: #7dd3fc; \}
#preview code \{ background: #2d2d30; border-radius: 4px; padding: 1px 5px; font-family: monospace; font-size: 13px; color: #ce9178; \}
#preview pre \{ background: #2d2d30; border-radius: 6px; padding: 12px; overflow-x: auto; \}
#preview pre code \{ background: none; padding: 0; color: #d4d4d4; \}
#preview blockquote \{ margin: 8px 0; padding: 4px 14px; border-left: 3px solid #3b82f6; color: #9ca3af; background: #252526; \}
#preview table \{ border-collapse: collapse; margin: 10px 0; \}
#preview th, #preview td \{ border: 1px solid #444; padding: 6px 12px; font-size: 14px; \}
#preview th \{ background: #2d2d30; \}
#preview img \{ max-width: 100%; \}
#preview hr \{ border: none; border-top: 1px solid #444; margin: 14px 0; \}
#findbar \{ display: none; align-items: center; gap: 6px; padding: 5px 12px; background: #2d2d30; border-bottom: 1px solid #333; flex: none; \}
#findbar.show \{ display: flex; \}
#findinput \{ background: #1e1e1e; color: #e8e8e8; border: 1px solid #444; border-radius: 4px; padding: 4px 8px; font-size: 13px; outline: none; width: 240px; \}
#findinput:focus \{ border-color: #3b82f6; \}
#findcount \{ font-size: 12px; color: #9ca3af; min-width: 56px; \}
#findcount.none \{ color: #f87171; \}
#findbar button.small \{ padding: 3px 9px; font-size: 12px; background: #4b5563; \}
#findbar button.small:hover \{ background: #6b7280; \}
#modal \{ display: none; position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0,0,0,.55); z-index: 100; align-items: center; justify-content: center; \}
#modal.show \{ display: flex; \}
#modal-box \{ background: #2d2d30; border: 1px solid #444; border-radius: 8px; box-shadow: 0 12px 40px rgba(0,0,0,.6); padding: 22px 26px 18px; min-width: 320px; max-width: 480px; \}
#modal-text \{ font-size: 14px; color: #e5e5e5; line-height: 1.5; margin-bottom: 18px; \}
#modal-btns \{ display: flex; justify-content: flex-end; gap: 8px; \}
#modal-btns button.secondary \{ background: #4b5563; \}
#modal-btns button.secondary:hover \{ background: #6b7280; \}
</style>
</head>
<body>
<div id="menubar">
<span class="menu-wrap">
<span class="menu-item" id="filemenu-btn">文件</span>
<div id="filemenu">
<div class="mi" data-act="newtab">新建标签页<span class="key">Ctrl+T</span></div>
<div class="mi" data-act="open">打开…<span class="key">Ctrl+O</span></div>
<div class="msep"></div>
<div class="mi" data-act="save">保存<span class="key">Ctrl+S</span></div>
<div class="mi" data-act="saveas">另存为…<span class="key">Ctrl+Shift+S</span></div>
<div class="msep"></div>
<div class="mi" data-act="find">查找<span class="key">Ctrl+F</span></div>
<div class="mi" data-act="close">关闭标签页<span class="key">Ctrl+W</span></div>
<div class="mi" data-act="exit">退出（整个编辑器）</div>
</div>
</span>
</div>
<input type="file" id="fileinput" accept=".md,.markdown,text/markdown" style="display:none">
<div id="tabbar"></div>
<div id="top">
<button id="paste">粘贴</button>
<button id="clear">清空</button>
<span id="status"></span>
</div>
<div id="findbar">
<input id="findinput" type="text" placeholder="查找(Ctrl+F)…" spellcheck="false">
<span id="findcount"></span>
<button class="small" id="findprev" title="上一个 (Shift+Enter)">↑</button>
<button class="small" id="findnext" title="下一个 (Enter)">↓</button>
<button class="small" id="findclose" title="关闭 (Esc)">✕</button>
</div>
<div id="main">
<div id="editorwrap">
<textarea id="editor" spellcheck="false" placeholder="在左侧输入或粘贴 Markdown，右侧实时预览…"></textarea>
<div id="findhl"></div>
</div>
<div id="splitter" title="拖动调整左右比例（双击复位）"></div>
<div id="preview"></div>
</div>
<div id="modal">
<div id="modal-box">
<div id="modal-text"></div>
<div id="modal-btns">
<button id="modal-save">保存</button>
<button class="secondary" id="modal-discard">不保存</button>
<button class="secondary" id="modal-cancel">取消</button>
</div>
</div>
</div>
<script>
var initialContent = {content_json};
var initialName = {file_json};
var winTitle = {title_json};
var initialPath = {path_json};
document.title = winTitle;
function $(id) \{ return document.getElementById(id); \}

function esc(s) \{
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
\}

// 行内格式：先保护行内代码，再处理图片/链接/粗体/斜体/删除线
function inline(s) \{
    var codes = [];
    s = s.replace(/`([^`]+)`/g, function(m, c) \{
        codes.push(c);
        return '\\u0000' + (codes.length - 1) + '\\u0000';
    \});
    s = s.replace(/!\[([^\]]*)\]\(([^)\\s]+)\)/g, '<img src="$2" alt="$1">');
    s = s.replace(/\[([^\]]+)\]\(([^)\\s]+)\)/g, '<a href="$2" target="_blank">$1</a>');
    s = s.replace(/\\*\\*([^*]+)\\*\\*/g, '<b>$1</b>');
    s = s.replace(/__([^_]+)__/g, '<b>$1</b>');
    s = s.replace(/~~([^~]+)~~/g, '<s>$1</s>');
    s = s.replace(/\\*([^*\\n]+)\\*/g, '<i>$1</i>');
    s = s.replace(/_([^_\\n]+)_/g, '<i>$1</i>');
    s = s.replace(/\\u0000(\\d+)\\u0000/g, function(m, i) \{
        return '<code>' + esc(codes[+i]) + '</code>';
    \});
    return s;
\}

// 块级解析：代码块 / 标题 / 分隔线 / 引用 / 表格 / 列表 / 段落
function md(text) \{
    var lines = text.replace(/\\r\\n?/g, '\\n').split('\\n');
    var out = [];
    var para = [];
    function flush() \{
        if (para.length > 0) \{
            out.push('<p>' + para.map(inline).join('<br>') + '</p>');
            para = [];
        \}
    \}
    var i = 0;
    while (i < lines.length) \{
        var line = lines[i];
        if (/^```/.test(line)) \{
            flush();
            var buf = [];
            i++;
            while (i < lines.length && !/^```/.test(lines[i])) \{ buf.push(lines[i]); i++; \}
            i++;
            out.push('<pre><code>' + esc(buf.join('\\n')) + '</code></pre>');
            continue;
        \}
        var h = line.match(/^(#\{1,6\})\\s+(.*)$/);
        if (h) \{
            flush();
            var lv = h[1].length;
            out.push('<h' + lv + '>' + inline(esc(h[2])) + '</h' + lv + '>');
            i++;
            continue;
        \}
        if (/^\\s*(-\{3,\}|\\*\{3,\})\\s*$/.test(line)) \{ flush(); out.push('<hr>'); i++; continue; \}
        if (/^>\\s?/.test(line)) \{
            flush();
            var q = [];
            while (i < lines.length && /^>\\s?/.test(lines[i])) \{ q.push(lines[i].replace(/^>\\s?/, '')); i++; \}
            out.push('<blockquote>' + md(q.join('\\n')) + '</blockquote>');
            continue;
        \}
        if (line.indexOf('|') >= 0 && i + 1 < lines.length && lines[i+1].indexOf('|') >= 0 && /^[\\s|:\\-]+$/.test(lines[i+1])) \{
            flush();
            function cells(row) \{
                return row.replace(/^\\s*\|/, '').replace(/\|\\s*$/, '').split('|').map(function(c) \{ return c.trim(); \});
            \}
            var head = cells(line);
            i += 2;
            var rows = [];
            while (i < lines.length && lines[i].indexOf('|') >= 0 && lines[i].trim() != '') \{ rows.push(cells(lines[i])); i++; \}
            var t = '<table><tr>';
            head.forEach(function(c) \{ t += '<th>' + inline(esc(c)) + '</th>'; \});
            t += '</tr>';
            rows.forEach(function(r) \{
                t += '<tr>';
                r.forEach(function(c) \{ t += '<td>' + inline(esc(c)) + '</td>'; \});
                t += '</tr>';
            \});
            out.push(t + '</table>');
            continue;
        \}
        if (/^\\s*[-*+]\\s+/.test(line)) \{
            flush();
            var items = [];
            while (i < lines.length && /^\\s*[-*+]\\s+/.test(lines[i])) \{ items.push(lines[i].replace(/^\\s*[-*+]\\s+/, '')); i++; \}
            out.push('<ul>' + items.map(function(x) \{ return '<li>' + inline(esc(x)) + '</li>'; \}).join('') + '</ul>');
            continue;
        \}
        if (/^\\s*\\d+\\.\\s+/.test(line)) \{
            flush();
            var oitems = [];
            while (i < lines.length && /^\\s*\\d+\\.\\s+/.test(lines[i])) \{ oitems.push(lines[i].replace(/^\\s*\\d+\\.\\s+/, '')); i++; \}
            out.push('<ol>' + oitems.map(function(x) \{ return '<li>' + inline(esc(x)) + '</li>'; \}).join('') + '</ol>');
            continue;
        \}
        if (line.trim() == '') \{ flush(); i++; continue; \}
        para.push(esc(line));
        i++;
    \}
    flush();
    return out.join('\\n');
\}

var ed = $('editor');

function render() \{
    hideFindHl(); // 内容/标签变化后匹配位置失效，清掉高亮（查找时再重新落位）
    $('preview').innerHTML = md(ed.value);
    renderTabs();
    if (curIdx < 0 || !tabs[curIdx]) \{
        $('status').textContent = '';
        document.title = 'Markdown 浏览器';
        return;
    \}
    var t = ed.value;
    var cur = tabs[curIdx];
    $('status').textContent = cur.name + ' · ' + t.length + ' 字符 · ' + t.split('\\n').length + ' 行';
    setTitle(cur);
\}

// ---------- 标签页管理 ----------
var tabs = [];      // \{name, path, content, saved, undo, redo, hist, lastAt\}
var curIdx = -1;
var untitledN = 0;
var COALESCE_MS = 600;   // 连续输入合并为一步撤销的时间窗
var UNDO_LIMIT = 100;    // 每标签页撤销栈上限

function baseName(p) \{ return p.split(/[\\/]/).pop(); \}
function setStatus(msg) \{ $('status').textContent = msg; \}

function makeTab(name, path, content) \{
    return \{name: name, path: path || '', content: content, saved: content,
            undo: [], redo: [], hist: \{v: content, s: 0, e: 0\}, lastAt: 0\};
\}

function syncActive() \{ if (curIdx >= 0 && tabs[curIdx]) \{ tabs[curIdx].content = ed.value; \} \}

function isDirty(t) \{
    var v = (t == tabs[curIdx]) ? ed.value : t.content;
    return v != t.saved;
\}

function setTitle(t) \{ document.title = (isDirty(t) ? '● ' : '') + t.name + ' - Markdown 浏览器'; \}

// ---------- 撤销 / 重做（自建栈；本环境下 WebKitGTK 原生 Ctrl+Z 实测不可用） ----------
function snapshotRaw(t, st) \{
    t.undo.push(st);
    if (t.undo.length > UNDO_LIMIT) \{ t.undo.shift(); \}
    t.redo.length = 0;
\}

// 程序化改动（Tab 缩进 / 清空 / 粘贴按钮）前调用：把改动前状态压栈
function snapshotUndo(t) \{
    snapshotRaw(t, \{v: ed.value, s: ed.selectionStart, e: ed.selectionEnd\});
\}

function markEdited(t) \{
    t.content = ed.value;
    t.hist = \{v: ed.value, s: ed.selectionStart, e: ed.selectionEnd\};
    t.lastAt = 0;
\}

function applyState(t, st) \{
    ed.value = st.v;
    var len = st.v.length;
    var s = Math.min(st.s, len);
    var e2 = Math.min(st.e, len);
    ed.setSelectionRange(s, e2);
    t.content = st.v;
    t.hist = \{v: st.v, s: s, e: e2\};
    t.lastAt = 0;
\}

function doUndo() \{
    if (curIdx < 0) \{ return; \}
    var t = tabs[curIdx];
    if (t.undo.length == 0) \{ return; \}
    t.redo.push(\{v: ed.value, s: ed.selectionStart, e: ed.selectionEnd\});
    applyState(t, t.undo.pop());
    render();
\}

function doRedo() \{
    if (curIdx < 0) \{ return; \}
    var t = tabs[curIdx];
    if (t.redo.length == 0) \{ return; \}
    t.undo.push(\{v: ed.value, s: ed.selectionStart, e: ed.selectionEnd\});
    if (t.undo.length > UNDO_LIMIT) \{ t.undo.shift(); \}
    applyState(t, t.redo.pop());
    render();
\}

function cycleTab(dir) \{
    if (tabs.length < 2) \{ return; \}
    syncActive();
    switchTab((curIdx + dir + tabs.length) % tabs.length);
\}

function newTabName() \{ untitledN++; return '(未命名 ' + untitledN + ')'; \}

function renderTabs() \{
    var bar = $('tabbar');
    bar.innerHTML = '';
    tabs.forEach(function(t, i) \{
        var el = document.createElement('div');
        el.className = 'tab' + (i == curIdx ? ' active' : '');
        var label = document.createElement('span');
        label.textContent = (isDirty(t) ? '● ' : '') + t.name;
        var x = document.createElement('span');
        x.className = 'x';
        x.textContent = '✕';
        x.title = '关闭标签页 (Ctrl+W)';
        x.onclick = function(ev) \{ ev.stopPropagation(); closeTab(i); \};
        el.appendChild(label);
        el.appendChild(x);
        if (t.path) \{ el.title = t.path; \}
        el.onclick = function() \{ switchTab(i); \};
        bar.appendChild(el);
    \});
\}

function switchTab(i) \{
    if (i == curIdx || i < 0 || i >= tabs.length) \{ return; \}
    syncActive();
    curIdx = i;
    var t = tabs[i];
    ed.value = t.content;
    t.hist = \{v: t.content, s: ed.selectionStart, e: ed.selectionEnd\};
    t.lastAt = 0;
    render();
    ed.focus();
\}

function newTab(name, path, content) \{
    syncActive();
    tabs.push(makeTab(name, path, content == null ? '' : content));
    curIdx = tabs.length - 1;
    ed.value = tabs[curIdx].content;
    render();
    ed.focus();
\}

function doNewTab() \{
    closeMenu();
    newTab(newTabName(), '', '');
\}

// 关闭标签页：有未保存更改先询问（保存 / 不保存 / 取消），取消则中止
function closeTab(i) \{
    if (i < 0 || i >= tabs.length) \{ return; \}
    syncActive();
    var t = tabs[i];
    if (!isDirty(t)) \{ reallyCloseTab(i); return; \}
    askUnsaved(t).then(function(r) \{
        if (r == 'cancel') \{ ed.focus(); return; \}
        if (r == 'save') \{
            saveTab(t).then(function(ok) \{
                if (!ok) \{ ed.focus(); return; \}
                closeByIdentity(t);
            \});
        \} else \{
            closeByIdentity(t);
        \}
    \});
    function closeByIdentity(t) \{
        var idx = tabs.indexOf(t);
        if (idx >= 0) \{ reallyCloseTab(idx); \}
    \}
\}

function reallyCloseTab(i) \{
    if (i < 0 || i >= tabs.length) \{ return; \}
    tabs.splice(i, 1);
    if (tabs.length == 0) \{
        // 关闭最后一个标签页：清空编辑区，保留空状态
        curIdx = -1;
        ed.value = '';
        render();
        return;
    \}
    if (curIdx >= tabs.length) \{ curIdx = tabs.length - 1; \}
    else if (i < curIdx) \{ curIdx--; \}
    var t = tabs[curIdx];
    ed.value = t.content;
    t.hist = \{v: t.content, s: ed.selectionStart, e: ed.selectionEnd\};
    t.lastAt = 0;
    render();
    ed.focus();
\}

// 打开文件：当前标签页有内容时新建标签页载入；空标签页（未命名且无路径）直接复用
function openFile(p, text) \{
    var name = baseName(p);
    if (curIdx >= 0 && tabs[curIdx].content == '' && !tabs[curIdx].path) \{
        // 复用当前空标签页
        tabs[curIdx] = makeTab(name, p, text);
        ed.value = text;
        tabs[curIdx].hist = \{v: text, s: ed.selectionStart, e: ed.selectionEnd\};
    \} else \{
        newTab(name, p, text);
    \}
    render();
    setStatus('已打开 ' + p);
    ed.focus();
\}

// 初始标签页：有内容或路径则载入，否则空状态
if (initialContent != '' || initialPath != '') \{
    tabs.push(makeTab(initialName, initialPath, initialContent));
    curIdx = 0;
    ed.value = initialContent;
\}
render();

var timer = null;
ed.addEventListener('input', function() \{
    var t = tabs[curIdx];
    if (t) \{
        t.content = ed.value;
        var now = Date.now();
        if (now - t.lastAt > COALESCE_MS) \{
            snapshotRaw(t, \{v: t.hist.v, s: t.hist.s, e: t.hist.e\});
        \}
        t.lastAt = now;
        t.hist = \{v: ed.value, s: ed.selectionStart, e: ed.selectionEnd\};
    \}
    if (timer) \{ clearTimeout(timer); \}
    timer = setTimeout(render, 120);
\});

// Tab 缩进两格 / Shift+Tab 反缩进（Ctrl+Tab、Ctrl+Shift+Tab 交给标签页切换）
// WebKitGTK(X11) 下 Shift+Tab 的 e.key 是 'Unidentified'，须用 e.code=='Tab' 识别
var isTabKey = function(e) \{ return e.key == 'Tab' || e.key == 'ISO_Left_Tab' || e.code == 'Tab'; \}
ed.addEventListener('keydown', function(e) \{
    if (!isTabKey(e) || e.ctrlKey || e.metaKey || e.altKey) \{ return; \}
    e.preventDefault();
    var t = tabs[curIdx];
    if (!t) \{ return; \}
    var s = ed.selectionStart;
    var en = ed.selectionEnd;
    if (e.shiftKey) \{
        var v = ed.value;
        var ls = v.lastIndexOf('\\n', s - 1) + 1;
        var m2 = v.slice(ls, ls + 2).match(/^ \{1,2\}/);
        if (!m2) \{ return; \}
        snapshotUndo(t);
        ed.setRangeText('', ls, ls + m2[0].length, 'end');
    \} else \{
        snapshotUndo(t);
        ed.setRangeText('  ', s, en, 'end');
    \}
    markEdited(t);
    render();
\});

function insertAtCursor(txt) \{
    if (!txt) \{ return; \}
    var t = tabs[curIdx];
    if (!t) \{ return; \}
    snapshotUndo(t);
    var s = ed.selectionStart;
    var en = ed.selectionEnd;
    ed.setRangeText(txt, s, en, 'end');
    markEdited(t);
    render();
\}

// 粘贴按钮：优先走原生桥 __cClipboardRead（webview），其次 Web API，失败则提示用 Ctrl+V
$('paste').onclick = function() \{
    if (window.__cClipboardRead) \{
        __cClipboardRead().then(function(t) \{
            if (t) \{ insertAtCursor(t); \} else \{ hintPaste(); \}
        \}).catch(function() \{ hintPaste(); \});
    \} else if (navigator.clipboard && navigator.clipboard.readText) \{
        navigator.clipboard.readText().then(insertAtCursor).catch(function() \{ hintPaste(); \});
    \} else \{ hintPaste(); \}
\};

function hintPaste() \{
    ed.focus();
    $('status').textContent = '无法直接读取剪贴板，请在编辑区按 Ctrl+V';
\}

$('clear').onclick = function() \{
    var t = tabs[curIdx];
    if (ed.value != '' && t) \{ snapshotUndo(t); \}
    ed.value = '';
    if (t) \{ markEdited(t); \}
    render();
    ed.focus();
\};

// ---------- 分隔条：拖动调整编辑区/预览区比例，双击复位 50:50 ----------
var splitter = $('splitter');
var mainEl = $('main');
var editorWrap = $('editorwrap');
function setSplit(x) \{
    var r = mainEl.getBoundingClientRect();
    var pct = (x - r.left) / r.width * 100;
    pct = Math.max(15, Math.min(85, pct)); // 两侧各留至少 15%
    editorWrap.style.width = pct + '%';
    if (hlIdx >= 0) \{ placeFindHl(hlIdx, hlLen); \} // 宽度变化会改变换行，重算高亮
\}
splitter.addEventListener('mousedown', function(e) \{
    e.preventDefault();
    splitter.classList.add('active');
    document.body.style.userSelect = 'none';
    document.body.style.cursor = 'col-resize';
    function onMove(ev) \{ setSplit(ev.clientX); \}
    function onUp() \{
        splitter.classList.remove('active');
        document.body.style.userSelect = '';
        document.body.style.cursor = '';
        document.removeEventListener('mousemove', onMove);
        document.removeEventListener('mouseup', onUp);
    \}
    document.addEventListener('mousemove', onMove);
    document.addEventListener('mouseup', onUp);
\});
splitter.addEventListener('dblclick', function() \{ editorWrap.style.width = '50%'; if (hlIdx >= 0) \{ placeFindHl(hlIdx, hlLen); \} \});

// ---------- 菜单栏：文件 → 新建 / 打开 / 保存 / 另存为 / 关闭 / 退出 ----------
var fileBtn = $('filemenu-btn');
var fileMenu = $('filemenu');
function closeMenu() \{ fileMenu.classList.remove('show'); fileBtn.classList.remove('open'); \}
fileBtn.onclick = function(e) \{
    e.stopPropagation();
    if (fileMenu.classList.contains('show')) \{ closeMenu(); \}
    else \{ fileMenu.classList.add('show'); fileBtn.classList.add('open'); \}
\};
document.addEventListener('click', closeMenu);

function doOpen() \{
    closeMenu();
    if (window.__cOpenFile) \{
        __cOpenFile('打开 Markdown 文件').then(function(p) \{
            if (!p) \{ return; \} // 用户取消
            if (window.__cReadFile) \{
                __cReadFile(p).then(function(t) \{ openFile(p, t); \});
            \} else \{ openFile(p, ''); \}
        \});
    \} else \{
        $('fileinput').click(); // 非 Linux：回退 <input type="file">
    \}
\}

// 保存：路径已知直接写；未命名走另存为。返回 Promise<bool>（true 已保存 / false 失败或取消）
function saveTab(t) \{
    syncActive();
    if (!t.path) \{ return saveTabAs(t); \}
    return writeTab(t, t.path, t.content);
\}

function writeTab(t, p, body) \{
    return new Promise(function(resolve) \{
        if (window.__cSaveFile) \{
            __cSaveFile(p, body, '').then(function(r) \{
                if (r == 'ok') \{ markSaved(t, p, body); resolve(true); \}
                else if (r && r.indexOf('error:') == 0) \{ setStatus('保存失败：' + r.slice(6)); resolve(false); \}
                else \{ resolve(false); \}
            \});
        \} else \{
            download(p, body);
            markSaved(t, p, body);
            resolve(true);
        \}
    \});
\}

function saveTabAs(t) \{
    syncActive();
    var body = t.content;
    var suggested = (t.name && t.name.indexOf('(未命名') != 0) ? t.name : 'untitled.md';
    if (window.__cSaveFile) \{
        return __cSaveFile('', body, suggested).then(function(r) \{
            if (!r) \{ setStatus('已取消保存'); return false; \} // 用户取消
            if (r.indexOf('error:') == 0) \{ setStatus('保存失败：' + r.slice(6)); return false; \}
            t.path = r;
            t.name = baseName(r);
            markSaved(t, r, body);
            return true;
        \});
    \}
    download(suggested, body);
    markSaved(t, suggested, body);
    return Promise.resolve(true);
\}

function markSaved(t, p, body) \{
    t.saved = body;
    setStatus('已保存 ' + p);
    renderTabs();
    if (t == tabs[curIdx]) \{ setTitle(t); \}
\}

function doSave() \{
    closeMenu();
    if (curIdx < 0) \{ return; \}
    saveTab(tabs[curIdx]);
\}

function doSaveAs() \{
    closeMenu();
    if (curIdx < 0) \{ return; \}
    saveTabAs(tabs[curIdx]);
\}

function doCloseTab() \{
    closeMenu();
    if (curIdx >= 0) \{ closeTab(curIdx); \}
\}

// ---------- 未保存更改对话框（自绘三键：保存 / 不保存 / 取消） ----------
var modalResolve = null;

function askUnsaved(t) \{
    return new Promise(function(resolve) \{
        if (modalResolve) \{ resolve('cancel'); return; \}
        modalResolve = resolve;
        $('modal-text').textContent = '「' + t.name + '」有未保存的更改。是否保存？';
        $('modal').classList.add('show');
        $('modal-save').focus();
    \});
\}

function closeModal(r) \{
    var f = modalResolve;
    modalResolve = null;
    $('modal').classList.remove('show');
    if (f) \{ f(r); \}
\}

$('modal-save').onclick = function() \{ closeModal('save'); \};
$('modal-discard').onclick = function() \{ closeModal('discard'); \};
$('modal-cancel').onclick = function() \{ closeModal('cancel'); \};
$('modal').addEventListener('keydown', function(e) \{
    if (e.key == 'Escape') \{ e.preventDefault(); closeModal('cancel'); \}
    else if (e.key == 'Enter') \{ e.preventDefault(); closeModal('save'); \}
\});

function doExit() \{
    closeMenu();
    exitWithSave();
\}

// 退出：按顺序逐个询问未保存标签；任一取消则中止退出
function exitWithSave() \{
    syncActive();
    var dirty = tabs.filter(function(t) \{ return isDirty(t); \});
    var i = 0;
    function next() \{
        if (i >= dirty.length) \{ realExit(); return; \}
        var t = dirty[i++];
        askUnsaved(t).then(function(r) \{
            if (r == 'cancel') \{ ed.focus(); return; \}
            if (r == 'save') \{
                saveTab(t).then(function(ok) \{ if (ok) \{ next(); \} \});
            \} else \{
                next();
            \}
        \});
    \}
    next();
\}

function realExit() \{
    if (window.__cExit) \{ __cExit(); \} else \{ window.close(); \}
\}

// 系统窗口关闭按钮（标题栏 ✕）：运行时拦截后回调到这里，走与 文件→退出 相同的流程
// （按顺序逐个询问未保存标签，任一取消则中止，窗口保持打开）
window.__onNativeClose = function() \{ exitWithSave(); \};

fileMenu.querySelectorAll('.mi').forEach(function(el) \{
    el.onclick = function(e) \{
        e.stopPropagation();
        var a = el.getAttribute('data-act');
        if (a == 'newtab') \{ doNewTab(); \}
        else if (a == 'open') \{ doOpen(); \}
        else if (a == 'save') \{ doSave(); \}
        else if (a == 'saveas') \{ doSaveAs(); \}
        else if (a == 'find') \{ closeMenu(); openFind(); \}
        else if (a == 'close') \{ doCloseTab(); \}
        else if (a == 'exit') \{ doExit(); \}
    \};
\});

// 非 Linux 回退：文件选择框 / 浏览器下载
$('fileinput').onchange = function() \{
    var f = this.files[0];
    if (!f) \{ return; \}
    var rd = new FileReader();
    rd.onload = function() \{ openFile(f.name, String(rd.result)); \};
    rd.readAsText(f);
    this.value = '';
\};

function download(name, text) \{
    var a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([text], \{type: 'text/markdown'\}));
    a.download = name;
    a.click();
    setStatus('已下载 ' + name);
\}

// ---------- 查找（Ctrl+F）：Enter 下一个 / Shift+Enter 上一个 / Esc 关闭 ----------
var findbar = $('findbar');
var findinput = $('findinput');

function openFind() \{
    findbar.classList.add('show');
    findinput.focus();
    if (findinput.value) \{ findinput.select(); \}
\}

function closeFind() \{
    findbar.classList.remove('show');
    hideFindHl();
    ed.focus();
\}

function countOccurrences(hay, needle) \{
    var c = 0, i = 0;
    while (true) \{
        i = hay.indexOf(needle, i);
        if (i < 0) \{ break; \}
        c++;
        i += needle.length;
    \}
    return c;
\}

function findMove(forward) \{
    var q = findinput.value;
    var el = $('findcount');
    if (!q) \{ el.textContent = ''; el.classList.remove('none'); hideFindHl(); return; \}
    var text = ed.value;
    var hay = text.toLowerCase();
    var needle = q.toLowerCase();
    var idx;
    if (forward) \{
        idx = hay.indexOf(needle, ed.selectionEnd);
        if (idx < 0) \{ idx = hay.indexOf(needle); \} // 回绕到开头
    \} else \{
        var back = ed.selectionStart - 1;
        idx = back >= 0 ? hay.lastIndexOf(needle, back) : -1;
        if (idx < 0) \{ idx = hay.lastIndexOf(needle); \} // 回绕到末尾
    \}
    if (idx < 0) \{ el.textContent = '0/0'; el.classList.add('none'); hideFindHl(); return; \}
    ed.setSelectionRange(idx, idx + q.length);
    revealLine(idx);
    // WebKitGTK 下 setSelectionRange 会把焦点抢到编辑区，导致后续按键（Enter 等）落进编辑器
    if (findbar.classList.contains('show') && document.activeElement !== findinput) \{ findinput.focus(); \}
    placeFindHl(idx, q.length);
    var total = countOccurrences(hay, needle);
    var rank = 1, j = 0;
    while (true) \{
        j = hay.indexOf(needle, j);
        if (j < 0 || j >= idx) \{ break; \}
        rank++;
        j += needle.length;
    \}
    el.textContent = rank + '/' + total;
    el.classList.remove('none');
\}

// ---------- 当前匹配高亮浮层 ----------
// WebKitGTK 下 textarea 失去焦点后不绘制选区，焦点保持在查找框时匹配处会毫无反馈；
// 用同字体/同换行规则的镜像元素测量匹配位置，在编辑区上覆盖一层高亮块（随滚动跟随）。
var findhl = $('findhl');
var hlIdx = -1, hlLen = 0, hlW = 0, hlH = 0, hlX = 0, hlY = 0;
var mirror = null;

function getMirror() \{
    if (mirror) \{ return mirror; \}
    mirror = document.createElement('div');
    mirror.style.cssText = 'position:fixed;left:-99999px;top:0;visibility:hidden;overflow:hidden;pointer-events:none;margin:0;border:none;white-space:pre-wrap;word-wrap:break-word;overflow-wrap:break-word;';
    var cs = getComputedStyle(ed);
    ['fontFamily', 'fontSize', 'fontWeight', 'lineHeight', 'letterSpacing', 'paddingTop', 'paddingRight', 'paddingBottom', 'paddingLeft'].forEach(function(prop) \{
        mirror.style[prop] = cs[prop];
    \});
    document.body.appendChild(mirror);
    return mirror;
\}

function measureHl(idx, len) \{
    var m = getMirror();
    m.style.boxSizing = 'border-box';
    m.style.width = ed.clientWidth + 'px';
    m.innerHTML = '';
    m.appendChild(document.createTextNode(ed.value.slice(0, idx)));
    var span = document.createElement('span');
    span.textContent = ed.value.slice(idx, idx + len);
    m.appendChild(span);
    var mr = m.getBoundingClientRect();
    var sr = span.getBoundingClientRect();
    hlX = sr.left - mr.left;
    hlY = sr.top - mr.top;
    hlW = sr.width;
    hlH = sr.height;
\}

function syncFindHl() \{
    if (hlIdx < 0 || !findhl) \{ if (findhl) \{ findhl.style.display = 'none'; \} return; \}
    findhl.style.display = 'block';
    findhl.style.left = (hlX - ed.scrollLeft) + 'px';
    findhl.style.top = (hlY - ed.scrollTop) + 'px';
    findhl.style.width = hlW + 'px';
    findhl.style.height = hlH + 'px';
\}

function placeFindHl(idx, len) \{
    hlIdx = idx;
    hlLen = len;
    measureHl(idx, len);
    syncFindHl();
\}

function hideFindHl() \{
    hlIdx = -1;
    if (findhl) \{ findhl.style.display = 'none'; \}
\}

ed.addEventListener('scroll', syncFindHl);

// 把匹配行滚动到可视区域（textarea 的 setSelectionRange 不会自动滚动）
function revealLine(idx) \{
    var lh = parseFloat(getComputedStyle(ed).lineHeight) || 22;
    var line = ed.value.slice(0, idx).split('\\n').length;
    var top = (line - 1) * lh;
    if (top < ed.scrollTop || top > ed.scrollTop + ed.clientHeight - lh * 2) \{
        ed.scrollTop = Math.max(0, top - ed.clientHeight / 2);
    \}
\}

findinput.addEventListener('input', function() \{ findMove(true); \});
findinput.addEventListener('keydown', function(e) \{
    if (e.key == 'Enter') \{ e.preventDefault(); findMove(!e.shiftKey); \}
    else if (e.key == 'Escape') \{ e.preventDefault(); closeFind(); \}
\});
$('findnext').onclick = function() \{ findMove(true); findinput.focus(); \};
$('findprev').onclick = function() \{ findMove(false); findinput.focus(); \};
$('findclose').onclick = function() \{ closeFind(); \};

// 快捷键：Ctrl+T 新建 / Ctrl+O 打开 / Ctrl+F 查找 / Ctrl+S 保存 / Ctrl+Shift+S 另存为 /
// Ctrl+W 关闭标签页 / Ctrl+Tab、Ctrl+Shift+Tab 切换标签 / Ctrl+Z 撤销 / Ctrl+Y、Ctrl+Shift+Z 重做
// （Mac 上 Cmd 同样有效）；Esc 关闭菜单与查找条
document.addEventListener('keydown', function(e) \{
    if ($('modal').classList.contains('show')) \{ return; \}
    if (e.key == 'Escape') \{
        closeMenu();
        if (findbar.classList.contains('show')) \{ closeFind(); \}
        return;
    \}
    if (!(e.ctrlKey || e.metaKey)) \{ return; \}
    var k = e.key.toLowerCase();
    if (k == 't') \{ e.preventDefault(); doNewTab(); \}
    else if (k == 'o') \{ e.preventDefault(); doOpen(); \}
    else if (k == 'f') \{ e.preventDefault(); openFind(); \}
    else if (k == 's') \{ e.preventDefault(); if (e.shiftKey) \{ doSaveAs(); \} else \{ doSave(); \} \}
    else if (k == 'w') \{ e.preventDefault(); doCloseTab(); \}
    else if (k == 'tab' || k == 'iso_left_tab' || e.code == 'Tab') \{ e.preventDefault(); cycleTab(e.shiftKey ? -1 : 1); \}
    else if (k == 'z') \{
        if (document.activeElement === findinput) \{ return; \}
        e.preventDefault();
        if (e.shiftKey) \{ doRedo(); \} else \{ doUndo(); \}
    \} else if (k == 'y') \{
        if (document.activeElement === findinput) \{ return; \}
        e.preventDefault();
        doRedo();
    \}
\});
</script>
</body>
</html>
"""

webview.html(html, title, 1080, 680)
