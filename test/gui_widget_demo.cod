// Codong GUI 对象式 API 测试：widget 对象 + 闭包回调

gui.init("Codong Widget Demo", 420, 300)

status = gui.label("尚未点击")
clicks = 0
btn = gui.button("点我", fn() {
    clicks = clicks + 1
    status.set_text("点击成功！")
})
entry = gui.entry("在这里输入...")

gui.add(status)
gui.add(btn)
gui.add(entry)

print("widget demo ready")

gui.run()
